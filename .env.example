# --- Supabase Postgres ---------------------------------------------------
# Runtime: Supavisor TRANSACTION mode (port 6543). Required for serverless —
# every Vercel invocation is a new short-lived connection. Always IPv4.
# Dashboard: Project Settings -> Database -> Connection string -> Transaction pooler.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
DATABSE_URL="postgresql://postgres.xzpmeqyspxxghobqocfl:upzXhqhpwgcuZrDJ@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Tooling only (drizzle-kit introspect / migrate). Never used at runtime.
# Supavisor SESSION mode (port 5432, SAME pooler host as above, not
# db.<ref>.supabase.co). Session mode keeps one connection per client, so it
# supports the prepared statements and catalog queries drizzle-kit needs,
# while transaction mode does not.
#
# NOTE: a true direct connection (db.<ref>.supabase.co:5432) is IPv6-only.
# The IPv4 add-on that would fix that is Pro plan and above, so on the Free
# plan the session pooler is the correct choice, not a workaround.
# DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:upzXhqhpwgcuZrDJ@db.xzpmeqyspxxghobqocfl.supabase.co:5432/postgres"

# If the generated DB password contains @ : / ? # or %, percent-encode it
# here, or just copy the ready-made string from the Supabase dashboard.

# --- App admin -----------------------------------------------------------
# The single login shared by /admin, /analytics and /preview.
# Mirrors WAYFINDER_ADMIN_USER / WAYFINDER_ADMIN_PASSWORD in the Python app.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# 32+ character secret for the encrypted iron-session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=""
